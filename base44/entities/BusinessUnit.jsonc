{
  "name": "BusinessUnit",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string",
      "description": "Business unit name (e.g. Finance, Engineering, Operations)"
    },
    "description": {
      "type": "string"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent business unit ID for hierarchical structures"
    },
    "parent_name": {
      "type": "string"
    },
    "head_name": {
      "type": "string",
      "description": "Business unit head / director"
    },
    "head_id": {
      "type": "string"
    },
    "cost_center": {
      "type": "string",
      "description": "Finance cost center code"
    },
    "location": {
      "type": "string",
      "description": "Physical location / region"
    },
    "risk_appetite_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "default": "moderate",
      "description": "Inherited risk appetite for this unit"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}