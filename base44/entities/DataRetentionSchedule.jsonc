{
  "name": "DataRetentionSchedule",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "schedule_id": {
      "type": "string",
      "description": "Unique schedule identifier e.g. DRS-001"
    },
    "data_type": {
      "type": "string",
      "enum": [
        "pii",
        "financial",
        "health",
        "biometric",
        "credentials",
        "behavioral",
        "special_category",
        "government_id",
        "payment_card",
        "system_logs",
        "email",
        "backup",
        "audit_trail",
        "other"
      ],
      "default": "pii",
      "description": "Category of data this retention schedule applies to"
    },
    "data_category_description": {
      "type": "string",
      "description": "Human-readable description of the data category e.g. 'Customer PII \u2014 account opening records'"
    },
    "retention_period_days": {
      "type": "number",
      "default": 365,
      "description": "Number of days to retain this data type before disposal"
    },
    "retention_basis": {
      "type": "string",
      "enum": [
        "legal",
        "regulatory",
        "contractual",
        "operational",
        "tax"
      ],
      "default": "regulatory",
      "description": "Why this retention period was chosen"
    },
    "legal_reference": {
      "type": "string",
      "description": "Specific legal/regulatory citation e.g. 'POPIA Section 14', 'GDPR Article 5(1)(e)', 'Companies Act s24', 'SARS requires 5 years'"
    },
    "disposal_method": {
      "type": "string",
      "enum": [
        "secure_deletion",
        "crypto_shredding",
        "physical_destruction",
        "degaussing",
        "anonymization",
        "overwrite",
        "data_wiping"
      ],
      "default": "secure_deletion",
      "description": "How data is disposed of at end of retention period"
    },
    "disposal_evidence_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether a certificate of destruction must be retained"
    },
    "last_disposal_date": {
      "type": "string",
      "format": "date",
      "description": "Last date a disposal cycle was executed"
    },
    "last_disposal_count": {
      "type": "number",
      "default": 0,
      "description": "Number of records disposed of in last cycle"
    },
    "disposal_certificate_url": {
      "type": "string",
      "description": "URL to the certificate of destruction evidence"
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled review of this retention schedule"
    },
    "review_frequency_months": {
      "type": "number",
      "default": 12,
      "description": "How often this schedule is reviewed (months)"
    },
    "data_location": {
      "type": "string",
      "description": "Where this data is stored e.g. AWS eu-west-1, on-prem Johannesburg"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "deprecated"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schedule_id",
    "data_type",
    "retention_period_days"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}