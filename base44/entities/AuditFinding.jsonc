{
  "name": "AuditFinding",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "finding_id": {
      "type": "string",
      "description": "Unique identifier e.g. FND-001"
    },
    "audit_id": {
      "type": "string",
      "description": "Parent audit ID"
    },
    "audit_title": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_remediation",
        "resolved",
        "accepted",
        "closed"
      ],
      "default": "open"
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "non_conformance",
        "observation",
        "opportunity",
        "major_nc",
        "minor_nc"
      ],
      "default": "observation"
    },
    "repeat_finding": {
      "type": "boolean",
      "default": false,
      "description": "Flagged true if this finding recurs from a previous audit cycle"
    },
    "previous_finding_id": {
      "type": "string",
      "description": "ID of the prior-cycle finding this repeats, if applicable"
    },
    "linked_control_id": {
      "type": "string",
      "description": "Control this finding relates to"
    },
    "linked_control_name": {
      "type": "string"
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Risks this finding creates or exacerbates"
    },
    "linked_framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Frameworks this finding impacts"
    },
    "linked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence related to this finding or its remediation"
    },
    "corrective_action": {
      "type": "string",
      "description": "Description of the corrective action plan"
    },
    "management_response": {
      "type": "string",
      "description": "Formal management response to the finding \u2014 acceptance, rebuttal, or action commitment"
    },
    "management_response_by": {
      "type": "string",
      "description": "Name of the manager who provided the formal response"
    },
    "management_response_at": {
      "type": "string",
      "format": "date",
      "description": "Date the management response was recorded"
    },
    "root_cause": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    },
    "closure_date": {
      "type": "string",
      "format": "date",
      "description": "Date the finding was formally closed after verification"
    },
    "evidence_url": {
      "type": "string",
      "description": "Link to closure evidence"
    },
    "framework_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}