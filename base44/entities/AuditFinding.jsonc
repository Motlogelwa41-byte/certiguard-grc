{
  "name": "AuditFinding",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique identifier e.g. FND-001"
    },
    "audit_id": {
      "type": "string",
      "description": "Parent audit ID"
    },
    "audit_title": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_remediation",
        "resolved",
        "accepted",
        "closed"
      ],
      "default": "open"
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "non_conformance",
        "observation",
        "opportunity",
        "major_nc",
        "minor_nc"
      ],
      "default": "observation"
    },
    "linked_control_id": {
      "type": "string",
      "description": "Control this finding relates to"
    },
    "linked_control_name": {
      "type": "string"
    },
    "corrective_action": {
      "type": "string",
      "description": "Description of the corrective action plan"
    },
    "root_cause": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_url": {
      "type": "string",
      "description": "Link to closure evidence"
    },
    "framework_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}