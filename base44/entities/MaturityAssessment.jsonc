{
  "name": "MaturityAssessment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string",
      "description": "Assessment name e.g. 'Q3 2026 GRC Maturity Baseline'"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "completed"
    },
    "overall_level": {
      "type": "number",
      "description": "Average current maturity level (1-5)"
    },
    "target_level": {
      "type": "number",
      "description": "Average target maturity level (1-5)"
    },
    "domain_scores": {
      "type": "string",
      "description": "JSON array of {domain, domain_name, current_level, target_level, notes}"
    },
    "roadmap": {
      "type": "string",
      "description": "JSON array of {id, domain, domain_name, title, current_level, target_level, actions, status, priority, owner_name, due_date}"
    },
    "summary": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}