{
  "name": "WebhookEndpoint",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string",
      "description": "Friendly label e.g. Splunk SIEM, Datadog Forwarder"
    },
    "url": {
      "type": "string",
      "description": "Destination webhook URL to receive forwarded compliance events"
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "control_failed",
          "control_status_change",
          "evidence_approved",
          "evidence_rejected",
          "risk_exceeded_tolerance",
          "certification_expiring",
          "finding_opened",
          "finding_remediated",
          "task_overdue",
          "policy_approved",
          "vendor_high_risk",
          "regulatory_change",
          "incident_created",
          "all"
        ]
      },
      "description": "Event categories this endpoint subscribes to"
    },
    "secret_token": {
      "type": "string",
      "description": "Shared secret used to sign outbound payloads (HMAC-SHA256 in X-CertiGuard-Signature header)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    },
    "last_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "pending"
      ],
      "default": "pending"
    },
    "last_status_code": {
      "type": "number"
    },
    "last_error": {
      "type": "string"
    },
    "delivery_count": {
      "type": "number",
      "default": 0
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "url"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}