{
  "name": "AccessReviewItem",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "access_summary": {
      "type": "string",
      "description": "Description of permissions, systems, and roles under review"
    },
    "reviewer_name": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pending",
        "certify",
        "revoke",
        "modify"
      ],
      "default": "pending"
    },
    "decision_notes": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed"
      ],
      "default": "open"
    }
  },
  "required": [
    "campaign_id",
    "user_name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}