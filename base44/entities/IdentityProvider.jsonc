{
  "name": "IdentityProvider",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "azure_ad",
        "google_workspace",
        "onelogin",
        "jumpcloud",
        "other"
      ],
      "default": "azure_ad"
    },
    "scim_base_url": {
      "type": "string",
      "description": "SCIM 2.0 endpoint base (e.g. https://tenant.scim.example/scim/v2)"
    },
    "api_base_url": {
      "type": "string"
    },
    "token_secret": {
      "type": "string",
      "description": "Name of the env var holding the SCIM/OAuth bearer token"
    },
    "scim_inbound_token": {
      "type": "string",
      "description": "Bearer token the IdP sends to our inbound SCIM endpoint \u2014 auto-generated, used to authenticate push provisioning requests"
    },
    "scim_inbound_url": {
      "type": "string",
      "description": "Full SCIM inbound endpoint URL displayed to admin for IdP configuration"
    },
    "saml_entrypoint": {
      "type": "string"
    },
    "saml_metadata_url": {
      "type": "string"
    },
    "saml_certificate": {
      "type": "string"
    },
    "sso_issuer": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "error"
      ],
      "default": "active"
    },
    "scim_enabled": {
      "type": "boolean",
      "default": true
    },
    "provision_new_users": {
      "type": "boolean",
      "default": false
    },
    "user_count": {
      "type": "number",
      "default": 0
    },
    "group_count": {
      "type": "number",
      "default": 0
    },
    "last_sync_at": {
      "type": "string"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}