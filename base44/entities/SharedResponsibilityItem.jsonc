{
  "name": "SharedResponsibilityItem",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "item_id": {
      "type": "string",
      "description": "Unique item identifier e.g. SRM-001"
    },
    "category": {
      "type": "string",
      "enum": [
        "infrastructure",
        "data_security",
        "identity_access",
        "network_security",
        "compliance",
        "incident_response",
        "data_classification",
        "encryption",
        "backup_recovery",
        "monitoring_logging",
        "vulnerability_management",
        "training_awareness"
      ],
      "default": "infrastructure",
      "description": "Responsibility domain"
    },
    "control_area": {
      "type": "string",
      "description": "Specific control area e.g. Physical data center security, OS patching, Access policies"
    },
    "responsibility_model": {
      "type": "string",
      "enum": [
        "provider_managed",
        "shared",
        "tenant_managed"
      ],
      "default": "shared",
      "description": "Who bears primary responsibility: Base44/Cloud (provider), the tenant, or both (shared)"
    },
    "provider_responsibility": {
      "type": "string",
      "description": "What the cloud provider / Base44 infrastructure is responsible for"
    },
    "tenant_responsibility": {
      "type": "string",
      "description": "What the tenant must configure or manage"
    },
    "provider_controls": {
      "type": "string",
      "description": "JSON array of specific provider-implemented controls: [{control, status}]"
    },
    "tenant_controls": {
      "type": "string",
      "description": "JSON array of specific tenant-required controls: [{control, status}]"
    },
    "framework_reference": {
      "type": "string",
      "description": "Compliance framework reference e.g. AWS Shared Responsibility Model, ISO 27001 A.14, CSA STAR"
    },
    "tenant_status": {
      "type": "string",
      "enum": [
        "configured",
        "partially_configured",
        "not_configured",
        "not_applicable"
      ],
      "default": "not_configured",
      "description": "Current tenant configuration status for this responsibility area"
    },
    "gap_identified": {
      "type": "boolean",
      "default": false,
      "description": "True when a gap is identified in the tenant's responsibility coverage"
    },
    "gap_notes": {
      "type": "string",
      "description": "Description of any identified gap in responsibility coverage"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "control_area",
    "responsibility_model"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}