{
  "name": "Policy",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Full policy text"
    },
    "category": {
      "type": "string",
      "enum": [
        "information_security",
        "data_privacy",
        "acceptable_use",
        "access_control",
        "incident_response",
        "business_continuity",
        "change_management",
        "vendor_management",
        "human_resources",
        "physical_security"
      ],
      "default": "information_security"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "pending_approval",
        "approved",
        "published",
        "rejected",
        "archived",
        "retired"
      ],
      "default": "draft"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "format": "date"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date the policy becomes formally effective"
    },
    "published_at": {
      "type": "string",
      "description": "ISO timestamp when the policy was published for acknowledgment"
    },
    "retirement_date": {
      "type": "string",
      "format": "date",
      "description": "Date the policy was formally retired and superseded"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    },
    "review_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "semi_annually",
        "annually",
        "biennially",
        "on_change"
      ],
      "default": "annually",
      "description": "Scheduled review cadence"
    },
    "framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Risks this policy mitigates or relates to"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Controls this policy mandates"
    },
    "linked_regulation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regulatory requirements this policy satisfies"
    },
    "linked_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Evidence proving policy is operating"
    },
    "acknowledgment_required": {
      "type": "boolean",
      "default": true
    },
    "acknowledgment_count": {
      "type": "number",
      "default": 0
    },
    "acknowledged_by": {
      "type": "string",
      "description": "JSON array of acknowledgment records: [{user_id, user_name, acknowledged_at, version}]"
    },
    "ack_requests_sent_at": {
      "type": "string",
      "description": "ISO timestamp of the last batch of acknowledgment request emails sent"
    },
    "approval_workflow": {
      "type": "string",
      "description": "JSON array of approval steps: [{step, approver_name, approver_email, status, signed_at, signature, comments}]"
    },
    "version_history": {
      "type": "string",
      "description": "JSON array of past versions: [{version, content, changed_by, changed_at, change_notes}]"
    },
    "rejection_reason": {
      "type": "string"
    },
    "submitted_for_review_at": {
      "type": "string"
    },
    "submitted_by": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}