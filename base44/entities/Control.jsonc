{
  "name": "Control",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "control_id": {
      "type": "string",
      "description": "Unique control identifier"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "access_control",
        "data_protection",
        "incident_response",
        "change_management",
        "risk_management",
        "security_operations",
        "business_continuity",
        "network_security",
        "physical_security",
        "compliance",
        "human_resources",
        "asset_management"
      ],
      "default": "access_control"
    },
    "status": {
      "type": "string",
      "enum": [
        "passing",
        "failing",
        "not_applicable",
        "not_tested"
      ],
      "default": "not_tested"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Frameworks this control maps to"
    },
    "framework_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "evidence_count": {
      "type": "number",
      "default": 0
    },
    "last_tested": {
      "type": "string",
      "format": "date"
    },
    "next_review": {
      "type": "string",
      "format": "date"
    },
    "automation_status": {
      "type": "string",
      "enum": [
        "automated",
        "manual",
        "partially_automated"
      ],
      "default": "manual"
    },
    "effectiveness_score": {
      "type": "number",
      "default": 0,
      "description": "Auto-calculated effectiveness 0-100 based on test pass rate, evidence freshness, failure frequency, and time-to-remediate"
    },
    "effectiveness_grade": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "critical",
        "untested"
      ],
      "default": "untested",
      "description": "Letter grade derived from effectiveness_score"
    },
    "effectiveness_factors": {
      "type": "string",
      "description": "JSON breakdown of effectiveness scoring: {test_pass_rate, evidence_freshness, failure_frequency, remediation_speed}"
    },
    "effectiveness_calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "control_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}