{
  "name": "ConflictOfInterest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "declaration_type": {
      "type": "string",
      "enum": [
        "conflict_of_interest",
        "outside_business",
        "gift_entertainment",
        "insider_threat",
        "related_party_transaction"
      ],
      "default": "conflict_of_interest"
    },
    "declarer_name": {
      "type": "string"
    },
    "declarer_email": {
      "type": "string"
    },
    "declarer_role": {
      "type": "string",
      "description": "Employee, Director, Consultant, Executive"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the potential conflict"
    },
    "related_party": {
      "type": "string",
      "description": "Name of the related party / organization involved"
    },
    "nature_of_conflict": {
      "type": "string"
    },
    "financial_interest": {
      "type": "boolean",
      "default": false
    },
    "financial_value": {
      "type": "number",
      "description": "Estimated financial value of the interest/gift"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "approved",
        "mitigation_required",
        "rejected"
      ],
      "default": "submitted"
    },
    "reviewer_name": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "mitigation_plan": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "declaration_type",
    "description"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}