{
  "name": "RemediationItem",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "remediation_id": {
      "type": "string",
      "description": "Unique remediation identifier (e.g., REM-001)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "gap_analysis",
        "audit_finding",
        "control_failure",
        "risk_treatment",
        "privacy_issue",
        "regulatory_obligation",
        "vulnerability",
        "incident_corrective",
        "vendor_assessment",
        "pen_test",
        "policy_exception",
        "kri_breach",
        "other"
      ],
      "default": "other",
      "description": "What triggered this remediation item"
    },
    "source_entity_type": {
      "type": "string",
      "description": "Entity type the remediation came from"
    },
    "source_entity_id": {
      "type": "string"
    },
    "source_ref": {
      "type": "string",
      "description": "Display reference (e.g., FND-001, RISK-005)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "in_review",
        "approved",
        "rejected",
        "closed",
        "overdue",
        "cancelled"
      ],
      "default": "open"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "dependencies": {
      "type": "string",
      "description": "JSON array of dependency descriptions or item IDs"
    },
    "evidence_url": {
      "type": "string",
      "description": "Evidence of remediation completion"
    },
    "evidence_name": {
      "type": "string"
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_notes": {
      "type": "string"
    },
    "closure_validation": {
      "type": "string",
      "description": "How closure was verified (re-test, evidence review, etc.)"
    },
    "closure_validated_by": {
      "type": "string"
    },
    "closure_validated_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalation_level": {
      "type": "number",
      "default": 0
    },
    "escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_unit_id": {
      "type": "string"
    },
    "business_unit_name": {
      "type": "string"
    },
    "framework_id": {
      "type": "string"
    },
    "framework_name": {
      "type": "string"
    },
    "remediation_actions": {
      "type": "string",
      "description": "JSON array of actions: [{action, completed, completed_date}]"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "source_type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}