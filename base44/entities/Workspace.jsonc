{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "workspace_id": {
      "type": "string",
      "description": "Unique workspace identifier e.g. WS-001"
    },
    "name": {
      "type": "string",
      "description": "Workspace or business unit name e.g. Retail Banking, Corporate Banking"
    },
    "description": {
      "type": "string"
    },
    "parent_workspace_id": {
      "type": "string",
      "description": "Parent workspace id for hierarchical BU structures (null for top-level)"
    },
    "workspace_type": {
      "type": "string",
      "enum": [
        "business_unit",
        "department",
        "division",
        "subsidiary",
        "product_line",
        "region",
        "project"
      ],
      "default": "business_unit"
    },
    "head_name": {
      "type": "string",
      "description": "Name of the workspace/BU head"
    },
    "head_id": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 0,
      "description": "Number of users assigned to this workspace"
    },
    "control_count": {
      "type": "number",
      "default": 0,
      "description": "Number of controls assigned to this workspace"
    },
    "risk_count": {
      "type": "number",
      "default": 0,
      "description": "Number of risks assigned to this workspace"
    },
    "compliance_score": {
      "type": "number",
      "default": 0,
      "description": "Aggregated compliance score for this workspace"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "description": "Aggregated risk score for this workspace"
    },
    "color": {
      "type": "string",
      "description": "Hex color for workspace identification in dashboards"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}