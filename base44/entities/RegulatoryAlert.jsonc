{
  "name": "RegulatoryAlert",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Plain-language summary of the regulatory change"
    },
    "framework_code": {
      "type": "string",
      "description": "Framework code (ISO, NIST, SADC, GDPR, POPIA, etc.)"
    },
    "framework_name": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "change_type": {
      "type": "string",
      "enum": [
        "new_regulation",
        "amendment",
        "repeal",
        "guidance",
        "enforcement"
      ],
      "default": "amendment"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "compliance_deadline": {
      "type": "string",
      "format": "date"
    },
    "source_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this alert banner is still pinned to the dashboard"
    },
    "dismissed_by_id": {
      "type": "string"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}