{
  "name": "AuditTrail",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "login",
        "logout",
        "export",
        "approve",
        "reject",
        "view",
        "import",
        "export_data"
      ]
    },
    "entity_type": {
      "type": "string",
      "description": "Which entity was affected (e.g., Control, Policy, Risk)"
    },
    "entity_id": {
      "type": "string"
    },
    "entity_name": {
      "type": "string"
    },
    "changes": {
      "type": "string",
      "description": "JSON diff of what changed"
    },
    "performed_by_name": {
      "type": "string"
    },
    "performed_by_id": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "geo_location": {
      "type": "string",
      "description": "Approximate geolocation from IP"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "tenant_name": {
      "type": "string"
    },
    "audit_hash": {
      "type": "string",
      "description": "Cryptographic chain hash \u2014 links to previous entry for immutability"
    },
    "prev_hash": {
      "type": "string",
      "description": "Previous entry's hash for chain verification"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical",
        "alert"
      ],
      "default": "info"
    },
    "metadata": {
      "type": "string",
      "description": "Additional context"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__append_only_denied__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__append_only_denied__"
      }
    }
  }
}