{
  "name": "TenantSettings",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "active_framework_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of frameworks this tenant has activated for compliance tracking"
    },
    "active_framework_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of active frameworks (denormalized for tooltips)"
    },
    "active_jurisdictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Active jurisdictions/countries for this tenant (e.g. South Africa, Botswana, Angola) \u2014 drives SADC cross-border data sovereignty checks"
    },
    "base_currency": {
      "type": "string",
      "default": "ZAR",
      "description": "Primary reporting currency for this tenant (ISO 4217 code: ZAR, USD, BWP, EUR, GBP, NGN, KES, GHS)"
    },
    "impact_1_min": {
      "type": "number",
      "description": "Monetary range minimum for impact level 1 (Negligible)"
    },
    "impact_1_max": {
      "type": "number",
      "description": "Monetary range maximum for impact level 1 (Negligible)"
    },
    "impact_2_min": {
      "type": "number",
      "description": "Monetary range minimum for impact level 2 (Minor)"
    },
    "impact_2_max": {
      "type": "number",
      "description": "Monetary range maximum for impact level 2 (Minor)"
    },
    "impact_3_min": {
      "type": "number",
      "description": "Monetary range minimum for impact level 3 (Moderate)"
    },
    "impact_3_max": {
      "type": "number",
      "description": "Monetary range maximum for impact level 3 (Moderate)"
    },
    "impact_4_min": {
      "type": "number",
      "description": "Monetary range minimum for impact level 4 (Major)"
    },
    "impact_4_max": {
      "type": "number",
      "description": "Monetary range maximum for impact level 4 (Major)"
    },
    "impact_5_min": {
      "type": "number",
      "description": "Monetary range minimum for impact level 5 (Catastrophic)"
    },
    "impact_5_max": {
      "type": "number",
      "description": "Monetary range maximum for impact level 5 (Catastrophic)"
    },
    "risk_appetite_limit": {
      "type": "number",
      "description": "Corporate Financial Risk Appetite Limit in base currency \u2014 maximum acceptable loss exposure (COSO ERM)"
    },
    "brand_display_name": {
      "type": "string",
      "description": "Custom organization display name shown in sidebar header and reports (white-label)"
    },
    "brand_logo_url": {
      "type": "string",
      "description": "Custom logo URL for white-label branding (overrides tenant logo_url)"
    },
    "brand_primary_color": {
      "type": "string",
      "description": "Primary brand hex color (e.g. #1e293b) injected as --primary CSS token"
    },
    "brand_secondary_color": {
      "type": "string",
      "description": "Secondary/accent brand hex color injected as --sidebar-primary CSS token"
    },
    "brand_accent_color": {
      "type": "string",
      "description": "Accent brand hex color injected as --ring CSS token"
    },
    "brand_footer_text": {
      "type": "string",
      "description": "Custom footer text shown in report footers and login screen"
    },
    "brand_login_message": {
      "type": "string",
      "description": "Custom welcome message on the login page"
    },
    "require_sso": {
      "type": "boolean",
      "default": false,
      "description": "When true, password login is disabled \u2014 users must authenticate via SSO (Google/Microsoft/enterprise IdP)"
    },
    "require_mfa": {
      "type": "boolean",
      "default": true,
      "description": "When true, all users must enroll MFA before accessing the platform (enforced by MfaEnforcementGate)"
    },
    "updated_by_name": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}