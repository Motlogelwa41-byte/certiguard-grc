{
  "name": "TenantInvite",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 the inviting tenant"
    },
    "inviter_id": {
      "type": "string",
      "description": "User ID of the person who sent the invite"
    },
    "inviter_name": {
      "type": "string",
      "description": "Display name of the inviter for email personalisation"
    },
    "invitee_email": {
      "type": "string",
      "description": "Email address of the invited colleague"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired"
      ],
      "default": "pending"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitee completed registration"
    },
    "accepted_by_id": {
      "type": "string",
      "description": "User ID of the invitee after they registered"
    }
  },
  "required": [
    "tenant_id",
    "inviter_id",
    "invitee_email"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}