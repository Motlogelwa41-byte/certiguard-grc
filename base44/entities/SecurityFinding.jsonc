{
  "name": "SecurityFinding",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "finding_id": {
      "type": "string",
      "description": "Unique finding identifier e.g. SF-2026-0001"
    },
    "source": {
      "type": "string",
      "enum": [
        "security_hub",
        "guardduty",
        "nessus",
        "qualys",
        "openvas",
        "crowdstrike",
        "defender",
        "rapid7",
        "tenable",
        "snipe",
        "gcp_scc",
        "other"
      ],
      "default": "other"
    },
    "cloud_provider": {
      "type": "string",
      "enum": [
        "aws",
        "azure",
        "gcp",
        "other"
      ],
      "default": "other",
      "description": "Cloud provider this finding originates from (CSPM)"
    },
    "posture_check": {
      "type": "string",
      "description": "CSPM category e.g. IAM, Encryption, Network, Logging, Configuration, Compliance"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "remediated",
        "accepted",
        "false_positive"
      ],
      "default": "open"
    },
    "cve": {
      "type": "string"
    },
    "asset": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "detected_date": {
      "type": "string",
      "format": "date"
    },
    "first_seen": {
      "type": "string"
    },
    "last_seen": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "remediated_date": {
      "type": "string",
      "format": "date"
    },
    "sla_hours": {
      "type": "number",
      "default": 0
    },
    "sla_breached": {
      "type": "boolean",
      "default": false
    },
    "owner_name": {
      "type": "string"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_control_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "connection_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "source"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}