{
  "name": "Risk",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "risk_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "operational",
        "technical",
        "compliance",
        "financial",
        "strategic",
        "reputational",
        "third_party",
        "emerging"
      ],
      "default": "operational"
    },
    "likelihood": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "default": 3,
      "description": "Qualitative likelihood (1-5)"
    },
    "impact": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "default": 3,
      "description": "Qualitative impact (1-5)"
    },
    "velocity": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "default": 3,
      "description": "Risk velocity \u2014 how quickly the risk could materialize (1=slow, 5=rapid onset)"
    },
    "inherent_risk_score": {
      "type": "number",
      "default": 0,
      "description": "Inherent risk score before controls (likelihood \u00d7 impact) \u2014 stored separately from residual"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "description": "Auto-calculated current risk score: likelihood \u00d7 impact"
    },
    "currency": {
      "type": "string",
      "default": "ZAR",
      "description": "ISO 4217 currency code for financial quantification (ZAR, USD, BWP, EUR, GBP, NGN, KES, GHS, ZMW, MZN, AOA, TZS)"
    },
    "quantitative_single_loss": {
      "type": "number",
      "description": "Inherent Impact ($) \u2014 single loss expectancy (SLE) in the risk's currency"
    },
    "quantitative_annual_rate": {
      "type": "number",
      "description": "Inherent Likelihood \u2014 annualized rate of occurrence (ARO, events per year)"
    },
    "annualized_loss_expectancy": {
      "type": "number",
      "default": 0,
      "description": "Auto-calculated inherent ALE: single_loss \u00d7 annual_rate (in risk currency)"
    },
    "residual_financial_impact": {
      "type": "number",
      "description": "Residual Impact ($) \u2014 financial impact after mitigations (COSO ERM), in risk currency"
    },
    "residual_likelihood_pct": {
      "type": "number",
      "description": "Residual Likelihood (%) \u2014 probability after mitigations (0-100, COSO ERM)"
    },
    "residual_annualized_loss_expectancy": {
      "type": "number",
      "default": 0,
      "description": "Auto-calculated residual ALE: residual_financial_impact \u00d7 (residual_likelihood_pct / 100)"
    },
    "control_effectiveness_pct": {
      "type": "number",
      "default": 0,
      "description": "Aggregate effectiveness of linked controls (0-100) \u2014 drives residual risk reduction"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "mitigating",
        "accepted",
        "transferred",
        "closed",
        "emerging"
      ],
      "default": "open"
    },
    "treatment": {
      "type": "string",
      "enum": [
        "mitigate",
        "accept",
        "transfer",
        "avoid"
      ],
      "default": "mitigate"
    },
    "treatment_plan": {
      "type": "string",
      "description": "Detailed treatment plan with milestones and actions"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "mitigation_plan": {
      "type": "string"
    },
    "related_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "residual_likelihood": {
      "type": "number",
      "default": 1
    },
    "residual_impact": {
      "type": "number",
      "default": 1
    },
    "appetite_band": {
      "type": "string",
      "enum": [
        "within_appetite",
        "tolerance_zone",
        "above_appetite",
        "unacceptable"
      ],
      "description": "Auto-classified band based on risk score vs company thresholds"
    },
    "exceeds_tolerance": {
      "type": "boolean",
      "default": false,
      "description": "Flagged when risk score exceeds the company tolerance threshold"
    },
    "exceeds_appetite_limit": {
      "type": "boolean",
      "default": false,
      "description": "Flagged when financial exposure (ALE) exceeds the tenant's risk_appetite_limit (COSO ERM)"
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "within_tolerance",
        "at_limit",
        "above_tolerance"
      ],
      "description": "Risk tolerance classification \u2014 distinct from appetite (appetite = willingness, tolerance = capacity)"
    },
    "tolerance_justification": {
      "type": "string",
      "description": "Reason accepted if risk exceeds tolerance (required for accepted treatment)"
    },
    "appetite_override": {
      "type": "boolean",
      "default": false,
      "description": "Manually override appetite classification"
    },
    "appetite_override_band": {
      "type": "string",
      "enum": [
        "within_appetite",
        "tolerance_zone",
        "above_appetite",
        "unacceptable"
      ],
      "description": "Manual override band if appetite_override is true"
    },
    "emerging_risk": {
      "type": "boolean",
      "default": false,
      "description": "Flagged true for newly identified or rapidly evolving risks requiring monitoring"
    },
    "trend": {
      "type": "string",
      "enum": [
        "increasing",
        "stable",
        "decreasing",
        "unknown"
      ],
      "default": "unknown",
      "description": "Risk score trend direction based on historical snapshots"
    },
    "accepted_by_name": {
      "type": "string",
      "description": "Name of the approver who formally accepted this risk"
    },
    "accepted_by_id": {
      "type": "string",
      "description": "User ID of the formal risk acceptor"
    },
    "accepted_at": {
      "type": "string",
      "format": "date",
      "description": "Date the risk was formally accepted"
    },
    "acceptance_expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date the formal acceptance expires and must be re-signed"
    },
    "acceptance_signature": {
      "type": "string",
      "description": "Typed full-name signature confirming formal sign-off authority"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}