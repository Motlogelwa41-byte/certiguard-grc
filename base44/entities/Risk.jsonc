{
  "name": "Risk",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "risk_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "operational",
        "technical",
        "compliance",
        "financial",
        "strategic",
        "reputational",
        "third_party"
      ],
      "default": "operational"
    },
    "likelihood": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "default": 3
    },
    "impact": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "default": 3
    },
    "risk_score": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "mitigating",
        "accepted",
        "transferred",
        "closed"
      ],
      "default": "open"
    },
    "treatment": {
      "type": "string",
      "enum": [
        "mitigate",
        "accept",
        "transfer",
        "avoid"
      ],
      "default": "mitigate"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "mitigation_plan": {
      "type": "string"
    },
    "related_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "residual_likelihood": {
      "type": "number",
      "default": 1
    },
    "residual_impact": {
      "type": "number",
      "default": 1
    },
    "appetite_band": {
      "type": "string",
      "enum": [
        "within_appetite",
        "tolerance_zone",
        "above_appetite",
        "unacceptable"
      ],
      "description": "Auto-classified band based on risk score vs company thresholds"
    },
    "exceeds_tolerance": {
      "type": "boolean",
      "default": false,
      "description": "Flagged when risk score exceeds the company tolerance threshold"
    },
    "tolerance_justification": {
      "type": "string",
      "description": "Reason accepted if risk exceeds tolerance (required for accepted treatment)"
    },
    "appetite_override": {
      "type": "boolean",
      "default": false,
      "description": "Manually override appetite classification"
    },
    "appetite_override_band": {
      "type": "string",
      "enum": [
        "within_appetite",
        "tolerance_zone",
        "above_appetite",
        "unacceptable"
      ],
      "description": "Manual override band if appetite_override is true"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}