{
  "name": "RegulatoryFramework",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "name": {
      "type": "string",
      "description": "Framework name (e.g., ISO 27001, NIST CSF, SADC Model Law, COSO ERM)"
    },
    "code": {
      "type": "string",
      "description": "Short code (ISO, NIST, SADC, COSO, GDPR, POPIA)"
    },
    "version": {
      "type": "string",
      "description": "Framework version (e.g., 2022, v1.5)"
    },
    "description": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "global",
        "us",
        "eu",
        "uk",
        "au",
        "za",
        "bw",
        "na",
        "mz",
        "zw",
        "zm",
        "tz",
        "ao",
        "sz",
        "ls",
        "mw",
        "cd",
        "mg",
        "mu",
        "sc",
        "sadc",
        "africa",
        "apac",
        "industry"
      ],
      "default": "global"
    },
    "sectors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Industry sectors this framework applies to (e.g., financial_services, healthcare, telecommunications)"
    },
    "authority": {
      "type": "string",
      "description": "Issuing body (ISO, NIST, SADC Secretariat, COSO, Information Regulator)"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date the framework or regulation became effective"
    },
    "category": {
      "type": "string",
      "enum": [
        "international",
        "national",
        "regional",
        "industry",
        "framework"
      ],
      "default": "framework"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated",
        "under_review"
      ],
      "default": "active"
    },
    "total_requirements": {
      "type": "number",
      "default": 0
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}