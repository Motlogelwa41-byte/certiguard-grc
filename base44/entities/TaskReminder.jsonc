{
  "name": "TaskReminder",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_title": {
      "type": "string"
    },
    "assignee_name": {
      "type": "string"
    },
    "assignee_email": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "days_before": {
      "type": "number",
      "description": "How many days before due date the reminder was sent"
    },
    "sent_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "default": "sent"
    },
    "priority": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "assignee_email"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}