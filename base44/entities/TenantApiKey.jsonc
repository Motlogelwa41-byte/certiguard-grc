{
  "name": "TenantApiKey",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "api_key": {
      "type": "string",
      "description": "The API key used for webhook authentication"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label for this key"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "rate_limit_per_hour": {
      "type": "number",
      "default": 1000,
      "description": "Token-bucket rate limit \u2014 max API requests per hour for this key"
    },
    "requests_this_hour": {
      "type": "number",
      "default": 0,
      "description": "Counter of requests made in the current hour window"
    },
    "hour_window_start": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp when the current rate-limit hour window started"
    },
    "created_by_name": {
      "type": "string"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "api_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}