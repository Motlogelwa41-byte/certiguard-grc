{
  "name": "QuestionnaireItem",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "questionnaire_id": {
      "type": "string"
    },
    "questionnaire_title": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string",
      "description": "Final answer sent to client"
    },
    "suggested_answer": {
      "type": "string",
      "description": "AI-drafted suggested answer"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "drafted",
        "verified",
        "needs_input",
        "none"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "drafted",
        "verified",
        "answered"
      ],
      "default": "pending"
    },
    "source_evidence_id": {
      "type": "string"
    },
    "source_control_id": {
      "type": "string"
    },
    "answered_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "questionnaire_id",
    "question"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}