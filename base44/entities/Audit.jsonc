{
  "name": "Audit",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "framework_id": {
      "type": "string"
    },
    "framework_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "internal",
        "external",
        "regulatory",
        "certification"
      ],
      "default": "internal"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "fieldwork",
        "reporting",
        "completed",
        "cancelled"
      ],
      "default": "planned"
    },
    "scope": {
      "type": "string",
      "description": "Structured audit scope \u2014 JSON array of scope items: [{entity_type, entity_id, entity_name, in_scope}]"
    },
    "objectives": {
      "type": "string",
      "description": "Audit objectives \u2014 what the audit aims to verify or achieve"
    },
    "criteria": {
      "type": "string",
      "description": "Audit criteria \u2014 standards, frameworks, or requirements against which conformance is assessed"
    },
    "auditor_name": {
      "type": "string"
    },
    "auditor_firm": {
      "type": "string"
    },
    "lead_auditor_id": {
      "type": "string",
      "description": "User ID of the internal lead auditor"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "findings_count": {
      "type": "number",
      "default": 0
    },
    "critical_findings": {
      "type": "number",
      "default": 0
    },
    "repeat_findings_count": {
      "type": "number",
      "default": 0,
      "description": "Number of findings that recur from a previous audit cycle"
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_exceptions",
        "fail",
        "pending"
      ],
      "default": "pending"
    },
    "report_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}