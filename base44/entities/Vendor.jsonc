{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "cloud_infrastructure",
        "saas",
        "data_processor",
        "consulting",
        "managed_services",
        "hardware",
        "other"
      ],
      "default": "saas"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "Business criticality tier of this vendor"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "description": "Auto-calculated internal risk score 0-100 from scoreVendorRisk"
    },
    "risk_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "default": "F"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "last_risk_assessment": {
      "type": "string",
      "format": "date-time"
    },
    "external_rating_score": {
      "type": "number",
      "default": 0,
      "description": "External security rating 0-100 fetched from threat intelligence (e.g. BitSight/SecurityScorecard-style estimate via web search)"
    },
    "external_rating_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "default": "F"
    },
    "external_rating_source": {
      "type": "string",
      "description": "Source of the external rating e.g. 'AI Threat Intel (web)'"
    },
    "external_rating_fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_rating_factors": {
      "type": "string",
      "description": "JSON array of rating factors: [{factor, score, detail}]"
    },
    "external_rating_summary": {
      "type": "string",
      "description": "Short human-readable summary of the external security posture"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "pending_review",
        "under_review",
        "rejected",
        "inactive"
      ],
      "default": "pending_review"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "secure_token": {
      "type": "string",
      "description": "Unique unguessable token for remote vendor portal access (e.g. security questionnaire submission)"
    },
    "contract_start": {
      "type": "string",
      "format": "date"
    },
    "contract_end": {
      "type": "string",
      "format": "date"
    },
    "data_access": {
      "type": "string",
      "enum": [
        "none",
        "limited",
        "moderate",
        "extensive"
      ],
      "default": "none"
    },
    "soc2_compliant": {
      "type": "boolean",
      "default": false
    },
    "iso27001_compliant": {
      "type": "boolean",
      "default": false
    },
    "gdpr_compliant": {
      "type": "boolean",
      "default": false
    },
    "last_assessment_date": {
      "type": "string",
      "format": "date"
    },
    "next_assessment_date": {
      "type": "string",
      "format": "date"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Controls this vendor is responsible for or impacts"
    },
    "linked_control_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compliance_notes": {
      "type": "string",
      "description": "Vendor-specific compliance obligations or gaps"
    },
    "offboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started",
      "description": "Formal vendor offboarding lifecycle stage"
    },
    "offboarding_date": {
      "type": "string",
      "format": "date",
      "description": "Date the offboarding was completed"
    },
    "offboarding_owner_name": {
      "type": "string",
      "description": "Person/team responsible for executing the offboarding"
    },
    "access_revoked_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "System access revoked and verified"
    },
    "credentials_revoked_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "API keys / shared credentials revoked"
    },
    "data_returned_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Data returned or securely destroyed"
    },
    "offboarding_notes": {
      "type": "string",
      "description": "Offboarding evidence and notes"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        },
        {
          "user_condition": {
            "role": "risk_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}