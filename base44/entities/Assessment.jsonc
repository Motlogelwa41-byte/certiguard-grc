{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "assessment_id": {
      "type": "string",
      "description": "Unique immutable assessment identifier (e.g., ASSESS-2026-001)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "framework",
        "regulation",
        "control_library",
        "organization",
        "department",
        "business_unit",
        "site",
        "vendor",
        "maturity"
      ],
      "default": "framework",
      "description": "What this assessment evaluates \u2014 drives question generation source"
    },
    "source_type": {
      "type": "string",
      "description": "Entity type the assessment was generated from: RegulatoryFramework, UniversalControl, BusinessUnit, Vendor, etc."
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source entity (framework, control library, BU, vendor, etc.)"
    },
    "source_name": {
      "type": "string",
      "description": "Display name of the source entity"
    },
    "scope": {
      "type": "string",
      "description": "JSON array of scope items included in the assessment: [{entity_type, entity_id, entity_name}]"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "total_questions": {
      "type": "number",
      "default": 0
    },
    "answered_questions": {
      "type": "number",
      "default": 0
    },
    "compliance_score": {
      "type": "number",
      "default": 0,
      "description": "Compliance score 0-100 \u2014 percentage of compliant/partially compliant responses"
    },
    "maturity_score": {
      "type": "number",
      "default": 0,
      "description": "Maturity score 1-5 \u2014 average maturity level across responses (distinct from compliance)"
    },
    "control_effectiveness_score": {
      "type": "number",
      "default": 0,
      "description": "Control effectiveness score 0-100 \u2014 how effectively controls are operating (distinct from compliance and maturity)"
    },
    "posture_state": {
      "type": "string",
      "enum": [
        "compliant",
        "partially_compliant",
        "non_compliant",
        "unknown",
        "not_applicable"
      ],
      "default": "unknown"
    },
    "responses": {
      "type": "string",
      "description": "JSON array of assessment responses: [{question_id, question_text, response (yes/no/partial/not_applicable/evidence_required), evidence_url, comments, score_weight, answered_by, answered_at}]"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "description": "AI-generated or manual assessment summary with key findings and recommendations"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "assessment_type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}