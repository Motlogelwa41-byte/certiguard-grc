{
  "name": "GrcAlertRule",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "rule_id": {
      "type": "string",
      "description": "Unique rule identifier (e.g., AR-001)"
    },
    "name": {
      "type": "string",
      "description": "Alert rule name"
    },
    "description": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "overdue_risk",
        "expired_evidence",
        "failed_control",
        "policy_review_due",
        "audit_finding_overdue",
        "regulatory_deadline",
        "privacy_obligation",
        "vendor_reassessment",
        "incident_open",
        "risk_appetite_breach",
        "kri_threshold_breach",
        "compliance_deterioration",
        "control_effectiveness_drop",
        "contract_expiring",
        "training_overdue",
        "certification_expiring"
      ],
      "description": "What type of alert this rule generates"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity to monitor (Risk, Evidence, Control, Policy, etc.)"
    },
    "condition": {
      "type": "string",
      "description": "JSON condition expression: [{field, operator, value}] \u2014 when true, alert fires"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "recipient_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles to notify (e.g., [risk_manager, compliance_officer])"
    },
    "recipient_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific user IDs to notify"
    },
    "escalation_after_hours": {
      "type": "number",
      "description": "Escalate if not acknowledged within this time"
    },
    "escalation_to_role": {
      "type": "string"
    },
    "notification_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "email",
          "slack"
        ]
      },
      "default": [
        "in_app"
      ],
      "description": "How to deliver the alert"
    },
    "dedup_window_hours": {
      "type": "number",
      "default": 24,
      "description": "Don't re-fire for the same entity within this window"
    },
    "auto_acknowledge_on_action": {
      "type": "boolean",
      "default": true,
      "description": "Auto-acknowledge when the underlying issue is resolved"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    },
    "last_fired_at": {
      "type": "string",
      "format": "date-time"
    },
    "fire_count": {
      "type": "number",
      "default": 0
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "alert_type",
    "entity_type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}