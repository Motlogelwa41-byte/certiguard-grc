{
  "name": "DataCenterIntegration",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "integration_id": {
      "type": "string",
      "description": "Unique integration identifier e.g. DCI-001"
    },
    "platform": {
      "type": "string",
      "enum": [
        "confluence_dc",
        "jira_dc"
      ],
      "description": "Which self-hosted platform this integration connects to"
    },
    "instance_name": {
      "type": "string",
      "description": "Friendly name for this Data Center instance"
    },
    "base_url": {
      "type": "string",
      "description": "Base URL of the self-hosted instance e.g. https://confluence.company.com"
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "pat",
        "basic_auth",
        "api_token"
      ],
      "default": "pat",
      "description": "Authentication method (PAT = Personal Access Token)"
    },
    "username": {
      "type": "string",
      "description": "Username for API authentication"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "connected",
        "error",
        "disconnected",
        "syncing",
        "pending"
      ],
      "default": "pending"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "spaces_synced": {
      "type": "string",
      "description": "JSON array of synced spaces: [{space_key, space_name, page_count, last_page_updated}]"
    },
    "total_spaces": {
      "type": "number",
      "default": 0
    },
    "total_pages_synced": {
      "type": "number",
      "default": 0
    },
    "total_issues_synced": {
      "type": "number",
      "default": 0,
      "description": "For Jira DC: number of issues/projects synced"
    },
    "access_events_tracked": {
      "type": "number",
      "default": 0,
      "description": "Number of document/page access events tracked from the DC instance"
    },
    "auto_sync_enabled": {
      "type": "boolean",
      "default": false
    },
    "sync_frequency": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly",
        "manual"
      ],
      "default": "daily"
    },
    "track_access_events": {
      "type": "boolean",
      "default": true,
      "description": "When true, track who accessed which documents/pages for audit evidence"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Controls that this integration provides evidence for"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "integration_id",
    "platform",
    "instance_name",
    "base_url"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}