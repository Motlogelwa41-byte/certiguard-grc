{
  "name": "BcdrPlan",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "process_name": {
      "type": "string",
      "description": "Critical business process name"
    },
    "description": {
      "type": "string"
    },
    "bia_category": {
      "type": "string",
      "enum": [
        "critical",
        "important",
        "normal"
      ],
      "default": "important",
      "description": "Business Impact Analysis category"
    },
    "criticality_rating": {
      "type": "number",
      "default": 3,
      "description": "1-5 criticality score"
    },
    "mtd_hours": {
      "type": "number",
      "description": "Maximum Tolerable Downtime (hours)"
    },
    "rto_hours": {
      "type": "number",
      "description": "Recovery Time Objective (hours)"
    },
    "rpo_hours": {
      "type": "number",
      "description": "Recovery Point Objective (hours)"
    },
    "dependencies": {
      "type": "string",
      "description": "Systems, vendors, personnel dependencies"
    },
    "recovery_strategy": {
      "type": "string",
      "description": "Active-active, active-passive, manual fallback, etc."
    },
    "alternate_site": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "business_unit_id": {
      "type": "string"
    },
    "business_unit_name": {
      "type": "string"
    },
    "last_test_date": {
      "type": "string",
      "format": "date"
    },
    "next_test_date": {
      "type": "string",
      "format": "date"
    },
    "test_type": {
      "type": "string",
      "enum": [
        "tabletop",
        "simulation",
        "full_failover",
        "parallel"
      ],
      "default": "tabletop"
    },
    "test_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "partial",
        "not_tested"
      ],
      "default": "not_tested"
    },
    "after_action_notes": {
      "type": "string",
      "description": "Post-exercise after-action report notes"
    },
    "critical_suppliers": {
      "type": "string",
      "description": "JSON array of critical supplier dependencies: [{vendor_id, vendor_name, service, alternative}]"
    },
    "recovery_test_results": {
      "type": "string",
      "description": "JSON array of test exercise results: [{date, type, rto_achieved, rpo_achieved, gaps_found, participants}]"
    },
    "remediation_items": {
      "type": "string",
      "description": "JSON array of BCDR remediation actions from test gaps: [{item, owner, due_date, status}]"
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Enterprise risk records linked to this critical process"
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Controls supporting this business continuity plan"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "process_name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "risk_manager"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}