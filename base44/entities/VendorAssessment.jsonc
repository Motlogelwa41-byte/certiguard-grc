{
  "name": "VendorAssessment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "vendor_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "security_due_diligence",
        "privacy_assessment",
        "reassessment",
        "remediation_review",
        "onboarding"
      ],
      "default": "security_due_diligence",
      "description": "Type of vendor assessment being conducted"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "in_progress",
        "submitted",
        "reviewed",
        "completed"
      ],
      "default": "draft"
    },
    "inherent_risk_score": {
      "type": "number",
      "default": 0,
      "description": "Inherent risk score 0-100 from the assessment before mitigations"
    },
    "residual_risk_score": {
      "type": "number",
      "default": 0,
      "description": "Residual risk score 0-100 after remediation of assessment findings"
    },
    "risk_score": {
      "type": "number",
      "default": 0
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "sent_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "answers": {
      "type": "string",
      "description": "JSON array of {question, answer, score, category}"
    },
    "remediation_items": {
      "type": "string",
      "description": "JSON array of remediation actions: [{item, severity, due_date, status, owner_name}]"
    },
    "notes": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "total_questions": {
      "type": "number",
      "default": 0
    },
    "answered_questions": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "vendor_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}