{
  "name": "VendorBIA",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "bia_id": {
      "type": "string",
      "description": "Unique BIA identifier e.g. BIA-001"
    },
    "vendor_id": {
      "type": "string",
      "description": "Linked Vendor id"
    },
    "vendor_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "business_process_impacted": {
      "type": "string",
      "description": "Primary business process dependent on this vendor"
    },
    "criticality_tier": {
      "type": "string",
      "enum": [
        "tier1_critical",
        "tier2_high",
        "tier3_moderate",
        "tier4_low"
      ],
      "default": "tier3_moderate",
      "description": "Supplier criticality tier \u2014 Tier 1 = critical (business stops), Tier 4 = low impact"
    },
    "financial_impact_annual": {
      "type": "number",
      "default": 0,
      "description": "Estimated annual financial impact if vendor fails (in tenant currency)"
    },
    "operational_impact": {
      "type": "string",
      "enum": [
        "severe",
        "major",
        "moderate",
        "minor",
        "negligible"
      ],
      "default": "moderate",
      "description": "Operational disruption severity if vendor becomes unavailable"
    },
    "reputational_impact": {
      "type": "string",
      "enum": [
        "severe",
        "major",
        "moderate",
        "minor",
        "negligible"
      ],
      "default": "moderate"
    },
    "rto_hours": {
      "type": "number",
      "default": 24,
      "description": "Recovery Time Objective \u2014 max acceptable downtime in hours"
    },
    "rpo_hours": {
      "type": "number",
      "default": 24,
      "description": "Recovery Point Objective \u2014 max acceptable data loss in hours"
    },
    "data_volume": {
      "type": "string",
      "enum": [
        "none",
        "minimal",
        "moderate",
        "large",
        "extensive"
      ],
      "default": "minimal",
      "description": "Volume of data shared with this vendor"
    },
    "data_sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "secret"
      ],
      "default": "internal",
      "description": "Highest sensitivity classification of data shared with vendor"
    },
    "dependency_type": {
      "type": "string",
      "enum": [
        "sole_source",
        "few_alternatives",
        "many_alternatives",
        "commodity"
      ],
      "default": "many_alternatives",
      "description": "How easily this vendor can be replaced"
    },
    "replacement_difficulty": {
      "type": "string",
      "enum": [
        "very_difficult",
        "difficult",
        "moderate",
        "easy",
        "trivial"
      ],
      "default": "moderate"
    },
    "alternate_suppliers": {
      "type": "string",
      "description": "JSON array of identified alternate suppliers: [{name, contact, readiness}]"
    },
    "bia_score": {
      "type": "number",
      "default": 0,
      "description": "Composite BIA score 0-100 \u2014 auto-calculated from impact, criticality, dependency, and data sensitivity"
    },
    "bia_grade": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "F"
      ],
      "default": "F",
      "description": "Letter grade derived from bia_score"
    },
    "critical_supplier": {
      "type": "boolean",
      "default": false,
      "description": "Auto-flagged true when BIA score exceeds critical threshold (>= 70)"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled BIA review \u2014 default 12 months from assessment"
    },
    "assessor_name": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "approved",
        "expired"
      ],
      "default": "draft"
    },
    "mitigation_plan": {
      "type": "string",
      "description": "Plan to reduce dependency or impact for critical suppliers"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "bia_id",
    "vendor_id",
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        },
        {
          "user_condition": {
            "role": "risk_manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}