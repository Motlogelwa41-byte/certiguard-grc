{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded evidence file (current version)"
    },
    "file_name": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Current version number \u2014 increments each time a new file replaces the previous one"
    },
    "previous_versions": {
      "type": "string",
      "description": "JSON array of prior versions: [{version, file_url, file_name, uploaded_at, uploaded_by_name, uploaded_by_id}]"
    },
    "control_id": {
      "type": "string"
    },
    "control_title": {
      "type": "string"
    },
    "framework_id": {
      "type": "string",
      "description": "Linked framework for compliance requirement mapping"
    },
    "framework_name": {
      "type": "string"
    },
    "requirement_id": {
      "type": "string",
      "description": "Specific FrameworkRequirement clause/reference this evidence satisfies"
    },
    "requirement_title": {
      "type": "string"
    },
    "linked_risk_id": {
      "type": "string",
      "description": "Risk this evidence supports or mitigates"
    },
    "linked_policy_id": {
      "type": "string",
      "description": "Policy this evidence demonstrates adherence to"
    },
    "linked_audit_id": {
      "type": "string",
      "description": "Audit this evidence was collected for"
    },
    "linked_vendor_id": {
      "type": "string",
      "description": "Vendor this evidence pertains to"
    },
    "linked_assessment_id": {
      "type": "string",
      "description": "Assessment this evidence supports"
    },
    "type": {
      "type": "string",
      "enum": [
        "screenshot",
        "document",
        "report",
        "log",
        "certificate",
        "configuration",
        "other"
      ],
      "default": "document"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "expired",
        "missing"
      ],
      "default": "pending_review"
    },
    "owner_name": {
      "type": "string",
      "description": "Person responsible for collecting and maintaining this evidence"
    },
    "owner_id": {
      "type": "string"
    },
    "collected_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Compliance manager or auditor who approved or rejected the evidence"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date",
      "description": "Date the formal review decision was made"
    },
    "review_notes": {
      "type": "string",
      "description": "Notes recorded during the formal approval or rejection"
    },
    "missing_evidence": {
      "type": "boolean",
      "default": false,
      "description": "Flagged true when evidence is required but not yet uploaded \u2014 drives missing-evidence alerts"
    },
    "missing_since": {
      "type": "string",
      "format": "date",
      "description": "Date the evidence was first flagged as missing"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}