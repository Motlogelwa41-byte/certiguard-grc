{
  "name": "TrustCenter",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "company_name": {
      "type": "string"
    },
    "company_tagline": {
      "type": "string"
    },
    "company_description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "show_frameworks": {
      "type": "boolean",
      "default": true
    },
    "show_controls_count": {
      "type": "boolean",
      "default": true
    },
    "show_uptime": {
      "type": "boolean",
      "default": true
    },
    "uptime_percentage": {
      "type": "number",
      "default": 99.9
    },
    "show_pentest": {
      "type": "boolean",
      "default": false
    },
    "pentest_date": {
      "type": "string",
      "format": "date"
    },
    "pentest_firm": {
      "type": "string"
    },
    "show_subprocessors": {
      "type": "boolean",
      "default": true
    },
    "subprocessors": {
      "type": "string",
      "description": "JSON array of {name, purpose, location}"
    },
    "custom_sections": {
      "type": "string",
      "description": "JSON array of {title, content}"
    },
    "accent_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "slug": {
      "type": "string",
      "description": "Public URL slug e.g. trust"
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "public",
        "request_access",
        "nda_required"
      ],
      "default": "public",
      "description": "Document access mode: public (open), request_access (form), nda_required (NDA must be signed)"
    },
    "nda_required": {
      "type": "boolean",
      "default": false,
      "description": "When true, visitors must sign an NDA before accessing compliance documents"
    },
    "nda_template": {
      "type": "string",
      "description": "NDA template text with {{visitor_name}}, {{visitor_company}}, {{company_name}} placeholders"
    },
    "nda_validity_days": {
      "type": "number",
      "default": 90,
      "description": "How many days NDA-based access remains valid"
    },
    "documents": {
      "type": "string",
      "description": "JSON array of compliance documents: [{id, name, description, url, requires_nda, category, last_updated}]"
    },
    "crm_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, visitor activity is synced to CRM via webhook"
    },
    "crm_webhook_url": {
      "type": "string",
      "description": "Webhook URL for CRM sync (Salesforce, HubSpot, etc.)"
    },
    "crm_provider": {
      "type": "string",
      "enum": [
        "salesforce",
        "hubspot",
        "pipedrive",
        "zoho",
        "custom",
        "none"
      ],
      "default": "none",
      "description": "Which CRM provider to sync visitor activity to"
    },
    "analytics_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, visitor activity is tracked for account-level analytics"
    },
    "auto_approve_access": {
      "type": "boolean",
      "default": false,
      "description": "When true, access requests are auto-approved without manual review"
    },
    "welcome_message": {
      "type": "string",
      "description": "Custom welcome message shown to visitors"
    },
    "badge_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the embeddable trust badge widget is accessible"
    },
    "badge_style": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "minimal"
      ],
      "default": "light",
      "description": "Visual style of the embeddable trust badge"
    },
    "badge_show_score": {
      "type": "boolean",
      "default": true,
      "description": "Show security score on the badge"
    },
    "badge_show_grade": {
      "type": "boolean",
      "default": true,
      "description": "Show letter grade on the badge"
    },
    "badge_show_frameworks": {
      "type": "boolean",
      "default": true,
      "description": "Show compliance frameworks on the badge"
    },
    "badge_show_certifications": {
      "type": "boolean",
      "default": true,
      "description": "Show active certifications on the badge"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}