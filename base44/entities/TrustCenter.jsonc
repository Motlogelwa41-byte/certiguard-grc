{
  "name": "TrustCenter",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "company_name": {
      "type": "string"
    },
    "company_tagline": {
      "type": "string"
    },
    "company_description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "show_frameworks": {
      "type": "boolean",
      "default": true
    },
    "show_controls_count": {
      "type": "boolean",
      "default": true
    },
    "show_uptime": {
      "type": "boolean",
      "default": true
    },
    "uptime_percentage": {
      "type": "number",
      "default": 99.9
    },
    "show_pentest": {
      "type": "boolean",
      "default": false
    },
    "pentest_date": {
      "type": "string",
      "format": "date"
    },
    "pentest_firm": {
      "type": "string"
    },
    "show_subprocessors": {
      "type": "boolean",
      "default": true
    },
    "subprocessors": {
      "type": "string",
      "description": "JSON array of {name, purpose, location}"
    },
    "custom_sections": {
      "type": "string",
      "description": "JSON array of {title, content}"
    },
    "accent_color": {
      "type": "string",
      "default": "#2563eb"
    },
    "slug": {
      "type": "string",
      "description": "Public URL slug e.g. trust"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}