{
  "name": "AccessReviewCampaign",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "description": "e.g. Q3 2026"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "in_review",
        "completed",
        "overdue"
      ],
      "default": "draft"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all_users",
        "admins_only",
        "custom"
      ],
      "default": "all_users"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "total_items": {
      "type": "number",
      "default": 0
    },
    "completed_items": {
      "type": "number",
      "default": 0
    },
    "certified_count": {
      "type": "number",
      "default": 0
    },
    "revoked_count": {
      "type": "number",
      "default": 0
    },
    "modified_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}