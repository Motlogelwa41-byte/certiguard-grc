{
  "name": "AuditorRequest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "scope_id": {
      "type": "string",
      "description": "Linked AuditorScope id"
    },
    "auditor_id": {
      "type": "string"
    },
    "auditor_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "description": "Clarification or additional-evidence request"
    },
    "related_control_id": {
      "type": "string"
    },
    "related_control_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "closed"
      ],
      "default": "open"
    },
    "response": {
      "type": "string",
      "description": "Compliance team response"
    },
    "responded_by": {
      "type": "string"
    },
    "responded_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "question"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}