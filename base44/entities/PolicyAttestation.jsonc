{
  "name": "PolicyAttestation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 mandatory on every record"
    },
    "policy_id": {
      "type": "string",
      "description": "Linked Policy entity id"
    },
    "policy_title": {
      "type": "string",
      "description": "Title of the policy at time of signing"
    },
    "policy_version": {
      "type": "string",
      "description": "Version of the policy the employee signed"
    },
    "employee_name": {
      "type": "string",
      "description": "Full name of the employee who signed"
    },
    "employee_id": {
      "type": "string",
      "description": "User ID of the signing employee"
    },
    "employee_email": {
      "type": "string",
      "description": "Email of the signing employee"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Exact timestamp of the attestation"
    },
    "signature": {
      "type": "string",
      "description": "Typed full-name signature confirming acknowledgment"
    },
    "acknowledgment_text": {
      "type": "string",
      "description": "The acknowledgment statement the employee agreed to"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address from which the attestation was submitted"
    }
  },
  "required": [
    "tenant_id",
    "policy_id",
    "employee_name",
    "employee_id",
    "signed_at"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}