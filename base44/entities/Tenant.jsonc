{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company/organization name"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe tenant identifier"
    },
    "industry": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": [
        "startup",
        "smb",
        "mid_market",
        "enterprise"
      ],
      "default": "smb"
    },
    "country": {
      "type": "string"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "starter",
        "ngo",
        "professional",
        "enterprise",
        "trial"
      ],
      "default": "trial"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "cancelled",
        "expired",
        "trial"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date"
    },
    "billing_email": {
      "type": "string"
    },
    "max_users": {
      "type": "number",
      "default": 5
    },
    "max_frameworks": {
      "type": "number",
      "default": 2
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Active feature flags"
    },
    "admin_name": {
      "type": "string"
    },
    "admin_email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer object ID linked to this tenant"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID for the active plan"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "description": "Current billing cycle"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.admin_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}