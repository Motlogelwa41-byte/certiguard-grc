{
  "name": "Connection",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "name": {
      "type": "string",
      "description": "Display name for this connection"
    },
    "service": {
      "type": "string",
      "enum": [
        "aws",
        "gcp",
        "azure",
        "github",
        "okta",
        "google_workspace",
        "google_drive",
        "datadog",
        "bamboohr",
        "jamf",
        "kandji",
        "slack",
        "crowdstrike",
        "splunk",
        "jira"
      ],
      "description": "Source system identifier"
    },
    "category": {
      "type": "string",
      "enum": [
        "cloud",
        "identity",
        "code",
        "monitoring",
        "hr",
        "device_management",
        "collaboration",
        "security",
        "ticketing"
      ],
      "default": "cloud"
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error",
        "needs_credentials"
      ],
      "default": "needs_credentials"
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "oauth",
        "api_key",
        "service_account",
        "bot_token",
        "manual"
      ],
      "default": "api_key"
    },
    "connector_type": {
      "type": "string",
      "description": "Base44 connector integration_type if backed by a platform connector"
    },
    "controls_monitored": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Control IDs this connection collects evidence for"
    },
    "control_count": {
      "type": "number",
      "default": 0
    },
    "evidence_collected_count": {
      "type": "number",
      "default": 0
    },
    "last_sync_at": {
      "type": "string"
    },
    "last_status": {
      "type": "string",
      "description": "ok, skipped, error"
    },
    "last_error": {
      "type": "string"
    },
    "health": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "error",
        "unknown"
      ],
      "default": "unknown"
    },
    "config": {
      "type": "string",
      "description": "JSON of non-secret settings (region, project, org handle, etc.)"
    },
    "secret_env_var": {
      "type": "string",
      "description": "Name of the app secret env var holding credentials for api_key/service_account types"
    },
    "auto_collect": {
      "type": "boolean",
      "default": true
    },
    "collect_frequency": {
      "type": "string",
      "enum": [
        "hourly",
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "connected_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "service"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}