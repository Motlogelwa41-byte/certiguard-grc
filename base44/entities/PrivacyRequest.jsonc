{
  "name": "PrivacyRequest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "request_id": {
      "type": "string",
      "description": "Unique identifier e.g. DSR-001"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_email": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "subject_access",
        "erasure",
        "rectification",
        "portability",
        "objection",
        "restriction",
        "marketing_opt_out",
        "other"
      ],
      "default": "subject_access"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "identity_verified",
        "in_progress",
        "gathering",
        "response_sent",
        "closed",
        "overdue",
        "rejected"
      ],
      "default": "received"
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "email",
        "phone",
        "letter",
        "other"
      ],
      "default": "web"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Statutory deadline"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "sla_days": {
      "type": "number",
      "default": 30
    },
    "sla_breached": {
      "type": "boolean",
      "default": false
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "data_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systems_involved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_method": {
      "type": "string"
    },
    "response_summary": {
      "type": "string"
    },
    "evidence_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "requester_name",
    "request_type"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}