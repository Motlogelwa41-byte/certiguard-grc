{
  "name": "BoardResolution",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "resolution_number": {
      "type": "string",
      "description": "Auto-generated e.g. BR-2026-001"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "resolution_type": {
      "type": "string",
      "enum": [
        "strategic_directive",
        "compliance_mandate",
        "risk_acceptance",
        "policy_approval",
        "budget_authorization",
        "governance_change",
        "other"
      ],
      "default": "compliance_mandate"
    },
    "meeting_date": {
      "type": "string",
      "format": "date"
    },
    "meeting_reference": {
      "type": "string",
      "description": "Board meeting reference e.g. Q3-2026-BM"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "overdue"
      ],
      "default": "pending"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "milestones": {
      "type": "string",
      "description": "JSON array: [{milestone, due_date, status, completed_date}]"
    },
    "sign_offs": {
      "type": "string",
      "description": "JSON array of board member sign-offs: [{member_name, role, signed_at, signature}]"
    },
    "linked_risk_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "compliance_officer"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}