{
  "name": "Incident",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key"
    },
    "incident_id": {
      "type": "string",
      "description": "Unique incident identifier (e.g., INC-2024-001)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "security_breach",
        "data_leak",
        "phishing",
        "malware",
        "unauthorized_access",
        "denial_of_service",
        "insider_threat",
        "physical_security",
        "policy_violation",
        "third_party",
        "other"
      ],
      "default": "security_breach"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "investigating",
        "contained",
        "remediated",
        "closed",
        "false_positive"
      ],
      "default": "detected"
    },
    "reported_by": {
      "type": "string"
    },
    "reported_date": {
      "type": "string",
      "format": "date"
    },
    "detected_date": {
      "type": "string",
      "format": "date"
    },
    "contained_date": {
      "type": "string",
      "format": "date"
    },
    "remediated_date": {
      "type": "string",
      "format": "date"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    },
    "affected_systems": {
      "type": "string"
    },
    "affected_data": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "response_summary": {
      "type": "string"
    },
    "lessons_learned": {
      "type": "string"
    },
    "notify_regulator": {
      "type": "boolean",
      "default": false
    },
    "regulator_notified_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to": {
      "type": "string"
    },
    "related_control_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeline_events": {
      "type": "string",
      "description": "JSON array of {timestamp, event, actor, severity_change, notes}"
    },
    "escalation_chain": {
      "type": "string",
      "description": "JSON array of {level, name, email, role, notified_at, acknowledged_at}"
    },
    "escalation_level": {
      "type": "number",
      "default": 0,
      "description": "Current escalation level (0=none, 1=team lead, 2=manager, 3=executive)"
    },
    "mttr_hours": {
      "type": "number",
      "description": "Mean time to resolve in hours (auto-calculated)"
    },
    "mttc_hours": {
      "type": "number",
      "description": "Mean time to contain in hours (auto-calculated)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}