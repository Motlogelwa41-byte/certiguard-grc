{
  "description": "Daily trial expiration scanner \u2014 downgrades expired trials and warns on trials expiring within 3 days",
  "name": "Trial Expiration Scanner",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 6 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trial_expiration_scanner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_trials": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkTrialExpiry",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan and expire trial subscriptions",
            "description": "Downgrade expired trials to expired status and identify trials expiring within 3 days"
          }
        }
      }
    ]
  }
}