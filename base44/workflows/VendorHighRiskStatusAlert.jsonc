{
  "name": "Vendor Critical Risk Alert",
  "description": "Posts a Slack alert to the compliance channel immediately whenever a vendor's risk level is escalated to critical.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Vendor",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.changed_fields | index(\"risk_level\") != null and .trigger.data.risk_level == \"critical\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vendor_critical_risk_alert",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "send_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSlackAlert",
            "args": {
              "text": ":rotating_light: Vendor risk escalated to CRITICAL: *${ .trigger.data.name }* is now marked critical risk. Status: ${ .trigger.data.status }. Review in CertiGuard."
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post Slack alert",
            "description": "Alert #compliance channel"
          }
        }
      }
    ]
  }
}