{
  "name": "Vendor Critical Risk Alert",
  "description": "Posts a Slack alert to the compliance channel whenever a vendor's risk level changes to high or critical.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Vendor",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.changed_fields | index(\"risk_level\") != null and (.trigger.data.risk_level == \"high\" or .trigger.data.risk_level == \"critical\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vendor_critical_risk_alert",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "send_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSlackAlert",
            "args": {
              "_internal_token": "cg-internal-invoke-7f3a9c2e1b8d4a6f9e2c",
              "text": ":rotating_light: Vendor risk level changed to ${ .trigger.data.risk_level }: *${ .trigger.data.name }* is now flagged ${ .trigger.data.risk_level } risk. Status: ${ .trigger.data.status }. Review in CertiGuard."
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post Slack alert",
            "description": "Alert #compliance channel"
          }
        }
      }
    ]
  }
}