{
  "description": "Posts a Slack alert to #compliance whenever a new risk is identified and created in the risk register, so risk owners and the team are notified instantly to stay on top of mitigation responsibilities.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Risk"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_new_risk_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSlackAlert",
            "args": {
              "_internal_token": "cg-internal-invoke-7f3a9c2e1b8d4a6f9e2c",
              "text": ":rotating_light: New risk identified\n*${ .trigger.data.title // \"Untitled risk\" }*\nCategory: ${ .trigger.data.category // \"\u2014\" } \u2022 Score: ${ .trigger.data.risk_score // \"\u2014\" } (L:${ .trigger.data.likelihood // \"\u2014\" } \u00d7 I:${ .trigger.data.impact // \"\u2014\" })\nOwner: ${ .trigger.data.owner_name // \"Unassigned\" } \u2022 Treatment: ${ .trigger.data.treatment // \"mitigate\" } \u2022 Status: ${ .trigger.data.status // \"open\" }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post Slack alert",
            "description": "New risk created \u2192 #compliance"
          }
        }
      }
    ]
  },
  "name": "Slack New Risk Alert"
}