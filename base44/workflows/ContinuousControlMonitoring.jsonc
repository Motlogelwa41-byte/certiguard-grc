{
  "description": "Daily automated testing of controls, evidence collection, and failing-control alerting via Slack",
  "name": "Continuous Control Monitoring",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "continuous_control_monitoring",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_monitoring": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "continuousControlMonitoring",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run continuous control monitoring",
            "description": "Test automated controls, collect evidence, alert failures"
          }
        }
      }
    ]
  }
}