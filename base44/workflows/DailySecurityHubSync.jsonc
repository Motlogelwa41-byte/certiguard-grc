{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Security Hub Sync",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_security_hub_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_security_hub": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAwsSecurityHub"
          },
          "then": "end",
          "x-base44": {
            "title": "Pull AWS Security Hub findings",
            "description": "Auto-import findings"
          }
        }
      }
    ]
  },
  "description": "Pulls findings from AWS Security Hub daily and ingests them as security findings with automatic SLA countdowns."
}