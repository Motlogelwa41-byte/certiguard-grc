{
  "name": "Weekly Subprocessor Monitor",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_subprocessor_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_subprocessor_scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "monitorSubprocessors"
          },
          "then": "end",
          "x-base44": {
            "title": "Run subprocessor monitoring scan",
            "description": "Sync and detect changes in vendor subprocessors (fourth parties)"
          }
        }
      }
    ]
  },
  "description": "Weekly automated fourth-party risk monitoring \u2014 syncs subprocessors from vendor contracts, detects new/modified/removed fourth parties, scores risk, and creates alerts for unapproved high-risk subprocessors."
}