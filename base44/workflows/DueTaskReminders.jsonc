{
  "name": "Due Task Reminders",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "due_task_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDueReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send due reminders",
            "description": "Email owners 7 days before due"
          }
        }
      }
    ]
  },
  "description": "Daily email reminders to control owners 7 days before evidence/audit tasks are due",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}