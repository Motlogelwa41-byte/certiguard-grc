{
  "name": "Slack Critical Risk Score Alert",
  "description": "Posts an urgent Slack alert to #compliance whenever a risk's score crosses INTO the critical threshold (>= 20) from below \u2014 fires only on the transition into critical, not on every update while already critical.",
  "trigger": {
    "condition": "${ (.trigger.data.risk_score // 0) >= 20 and ((.trigger.old_data.risk_score // 0) < 20) }",
    "config": {
      "trigger_type": "entity",
      "entity_name": "Risk",
      "events": [
        "create",
        "update"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_critical_risk_score",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_critical_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendSlackAlert",
            "args": {
              "_internal_token": "cg-internal-invoke-7f3a9c2e1b8d4a6f9e2c",
              "text": ":rotating_light: *RISK ESCALATED TO CRITICAL*\n*${ .trigger.data.title // \"Untitled risk\" }*\n:fire: Risk Score: *${ .trigger.data.risk_score // \"\u2014\" }* (was ${ .trigger.old_data.risk_score // \"\u2014\" } \u2192 now critical)\nLikelihood ${ .trigger.data.likelihood // \"\u2014\" } \u00d7 Impact ${ .trigger.data.impact // \"\u2014\" } \u2022 Category: ${ .trigger.data.category // \"\u2014\" }\nTreatment: ${ .trigger.data.treatment // \"mitigate\" } \u2022 Status: ${ .trigger.data.status // \"open\" } \u2022 Owner: ${ .trigger.data.owner_name // \"Unassigned\" }\n> Immediate review and mitigation action required \u2014 this risk just crossed the critical tolerance threshold."
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post critical risk Slack alert",
            "description": "Risk score crossed into critical (>= 20) \u2192 urgent #compliance alert"
          }
        }
      }
    ]
  }
}