{
  "name": "New Task Email Notification",
  "description": "Emails the assignee via Gmail whenever a new compliance task is assigned to them.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ComplianceTask",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.assignee_email != null and .trigger.data.assignee_email != \"\" and .trigger.data.status != \"completed\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_task_email_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_assignment_email": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendTaskAssignmentEmail",
            "args": {
              "_internal_token": "cg-internal-invoke-7f3a9c2e1b8d4a6f9e2c",
              "task": {
                "id": "${ .trigger.entity_id }",
                "title": "${ .trigger.data.title }",
                "description": "${ .trigger.data.description }",
                "due_date": "${ .trigger.data.due_date }",
                "priority": "${ .trigger.data.priority }",
                "type": "${ .trigger.data.type }",
                "assignee_name": "${ .trigger.data.assignee_name }",
                "assignee_email": "${ .trigger.data.assignee_email }",
                "status": "${ .trigger.data.status }",
                "tenant_id": "${ .trigger.data.tenant_id }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email assignee about new task",
            "description": "Sent via Gmail"
          }
        }
      }
    ]
  }
}