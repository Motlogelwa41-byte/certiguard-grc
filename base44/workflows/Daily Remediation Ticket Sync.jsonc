{
  "name": "Daily Remediation Ticket Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_remediation_ticket_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_tickets": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncRemediationTickets",
            "payload": {
              "action": "sync_status"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Run two-way remediation ticket sync",
            "description": "Poll Jira/Linear/Asana/ClickUp for ticket status changes and auto-close resolved remediation items"
          }
        }
      }
    ]
  },
  "description": "Daily automated two-way sync \u2014 polls external ticketing systems (Jira, Linear, Asana, ClickUp) for status changes, auto-closes remediation items when tickets are resolved, and updates sync state."
}