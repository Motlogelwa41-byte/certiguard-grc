{
  "name": "Weekly Evidence Reminders",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_evidence_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWeeklyEvidenceReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly evidence reminders",
            "description": "Email employees with pending evidence tasks"
          }
        }
      }
    ]
  },
  "description": "Sends a weekly digest email to each employee with pending evidence collection tasks, reminding them to upload their documentation via the Evidence Manager."
}